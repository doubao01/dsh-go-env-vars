{
  "name": "dsh-go-env-vars",
  "version": "1.0.0",
  "description": "DSH Go 原生插件：在手机面板里管理环境变量，经 ctx.shellEnv 注入为 $DSH_VAR_<名称> · Native dsh-go plugin: manage environment variables in a panel, injected into every shell command as $DSH_VAR_<NAME>",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "market-entry.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-go",
    "deepseek-harness",
    "environment-variables",
    "secrets",
    "cordis"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "node ~/.dsh/skills/dsh-go-plugin/kit/bin/check.mjs . --load"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "node": ">=22"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "环境变量",
      "en": "Env vars"
    },
    "icon": "terminal",
    "contributes": {
      "composer.tools": [
        {
          "id": "open-env",
          "label": {
            "zh": "环境变量",
            "en": "Env vars"
          },
          "icon": "terminal",
          "panel": "env"
        }
      ],
      "panels": [
        {
          "id": "env",
          "title": {
            "zh": "环境变量",
            "en": "Env vars"
          },
          "icon": "terminal",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ]
        }
      ],
      "composer.strip": [
        {
          "id": "env-count",
          "icon": "terminal",
          "text": {
            "zh": "环境变量",
            "en": "Env vars"
          },
          "panel": "env"
        }
      ]
    },
    "minApp": "1.0.12"
  },
  "author": "doubao01",
  "homepage": "https://github.com/doubao01/dsh-go-env-vars#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doubao01/dsh-go-env-vars.git"
  },
  "bugs": {
    "url": "https://github.com/doubao01/dsh-go-env-vars/issues"
  }
}